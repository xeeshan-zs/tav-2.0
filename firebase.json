{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/services", "destination": "/index.html" },
      { "source": "/services/**", "destination": "/index.html" },
      { "source": "/work", "destination": "/index.html" },
      { "source": "/team", "destination": "/index.html" },
      { "source": "/brand", "destination": "/index.html" },
      { "source": "/terms", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Vary",
            "value": "Accept, Accept-Encoding"
          }
        ]
      },
      {
        "source": "/404.html",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
